# =============================================================
#  Milhas - variaveis de ambiente
# -------------------------------------------------------------
#  Copie este arquivo para .env.local e preencha os valores.
#  O .env.local NAO vai para o git. Este .env.example vai,
#  e serve como documentacao das chaves necessarias.
#
#  REGRA DE SEGURANCA: tudo que comeca com NEXT_PUBLIC_ vai
#  para o bundle do navegador e fica visivel para qualquer um.
#  As demais variaveis sao lidas SOMENTE dentro de app/api/**.
#
#  O app sobe e funciona com TUDO em branco: nesse caso ele usa
#  a base curada em data/. Nenhuma credencial e bloqueante.
# =============================================================


# --- Supabase ------------------------------------------------
# Onde: supabase.com -> seu projeto -> Project Settings -> API
# (em projetos novos as chaves podem aparecer como
#  "publishable" = anon e "secret" = service role)

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Usada apenas pelo cron para gravar em precos_snapshot.
# Ignora as politicas de RLS do banco.
# NUNCA coloque o prefixo NEXT_PUBLIC_ nesta chave.
SUPABASE_SERVICE_ROLE_KEY=


# --- Travelpayouts -------------------------------------------
# Onde: travelpayouts.com -> cadastro gratuito ->
#       Para Desenvolvedores -> Token da API
# O token sai na hora, sem exigencia de trafego.
# Server-only: usado so pelas rotas em app/api/.

TRAVELPAYOUTS_TOKEN=

# Seu marker de afiliado. So e aplicado se a monetizacao
# estiver ligada (veja a ultima secao).
TRAVELPAYOUTS_MARKER=


# --- Cron ----------------------------------------------------
# Segredo que protege /api/cron/snapshot. Sem ele o endpoint
# fica aberto e qualquer um na internet pode disparar sua
# coleta, queimando o rate limit da API e enchendo seu banco.
# Gere com:  openssl rand -hex 32

CRON_SECRET=


# --- Monetizacao ---------------------------------------------
# false = links saem limpos, sem marker, e o selo de divulgacao
#         nao e renderizado (nao ha comissao, nada a declarar).
# true  = links de afiliado ativos + selo visivel.
#         Exige plano Vercel Pro (o Hobby e so para uso
#         nao-comercial).

NEXT_PUBLIC_MONETIZACAO_ATIVA=false
